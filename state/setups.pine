            en = str.tonumber(array.get(f, 5))
            sl = str.tonumber(array.get(f, 6))
            t1 = str.tonumber(array.get(f, 7))
            t2 = str.tonumber(array.get(f, 8))
            c = isLong ? color.green : color.red
            tag = (isLong ? "BUY " : "SELL ") + array.get(f, 2) + " (" + array.get(f, 9) + ")"
